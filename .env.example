# Supabase — copie os valores do dashboard:
# https://supabase.com/dashboard/project/<project-ref>/settings/api
#
# ATENÇÃO: tudo que começa com VITE_ vai pro bundle do navegador. Só a chave
# anon/publishable entra aqui. A service_role NUNCA — ela mora nos secrets das
# edge functions (`supabase secrets set`).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-public-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# ── Expiração de sessão (opcional) ─────────────────────────────────────────
# Sem estes valores o app usa os defaults de src/lib/security/session-policy.ts.
# Valores em MINUTOS.
#
# Dashboard interno (RH/gestores/diretoria — vê CPF, salário, folha inteira)
VITE_SESSION_IDLE_MINUTES=30
VITE_SESSION_ABSOLUTE_MINUTES=720
#
# Portal do colaborador (cada um só vê os próprios dados)
VITE_PORTAL_SESSION_IDLE_MINUTES=30
VITE_PORTAL_SESSION_ABSOLUTE_MINUTES=480
